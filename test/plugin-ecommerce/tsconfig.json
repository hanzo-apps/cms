{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@payload-config": ["./config.ts"],
      "@payload-types": ["./payload-types.ts"],
      "@/components/*": ["./app/components/*"],
      "@hanzo/cms-plugin-ecommerce": ["../../packages/plugin-ecommerce/exports/index.ts"],
      "@hanzo/cms-plugin-ecommerce/*": ["../../packages/plugin-ecommerce/exports/*"],
      "@hanzo/cms-ui/assets": ["../../packages/ui/src/assets/index.ts"],
      "@hanzo/cms-ui/elements/*": ["../../packages/ui/src/elements/*/index.tsx"],
      "@hanzo/cms-ui/fields/*": ["../../packages/ui/src/fields/*/index.tsx"],
      "@hanzo/cms-ui/forms/*": ["../../packages/ui/src/forms/*/index.tsx"],
      "@hanzo/cms-ui/graphics/*": ["../../packages/ui/src/graphics/*/index.tsx"],
      "@hanzo/cms-ui/hooks/*": ["../../packages/ui/src/hooks/*.ts"],
      "@hanzo/cms-ui/icons/*": ["../../packages/ui/src/icons/*/index.tsx"],
      "@hanzo/cms-ui/providers/*": ["../../packages/ui/src/providers/*/index.tsx"],
      "@hanzo/cms-ui/templates/*": ["../../packages/ui/src/templates/*/index.tsx"],
      "@hanzo/cms-ui/utilities/*": ["../../packages/ui/src/utilities/*.ts"],
      "@hanzo/cms-ui/scss": ["../../packages/ui/src/scss.scss"],
      "@hanzo/cms-ui/scss/app.scss": ["../../packages/ui/src/scss/app.scss"],
      "payload/types": ["../../packages/payload/src/exports/types.ts"],
      "@hanzo/cms-next/*": ["../../packages/next/src/*"],
      "@hanzo/cms-next": ["../../packages/next/src/exports/*"]
    }
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
