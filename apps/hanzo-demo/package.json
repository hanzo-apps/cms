{
  "name": "@hanzo/cms-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Reference Hanzo CMS app: Base/SQLite (per-org) + SeaweedFS S3 + IAM SSO + org==tenant + white-label.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation hanzo-cms generate:importmap && next build --webpack",
    "dev": "next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation hanzo-cms generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation hanzo-cms generate:types",
    "start": "next start"
  },
  "dependencies": {
    "@hanzo/cms": "workspace:*",
    "@hanzo/cms-auth-iam": "workspace:*",
    "@hanzo/cms-db-sqlite": "workspace:*",
    "@hanzo/cms-next": "workspace:*",
    "@hanzo/cms-plugin-multi-tenant": "workspace:*",
    "@hanzo/cms-plugin-whitelabel": "workspace:*",
    "@hanzo/cms-richtext-lexical": "workspace:*",
    "@hanzo/cms-storage-s3": "workspace:*",
    "@hanzo/cms-ui": "workspace:*",
    "cross-env": "catalog:",
    "graphql": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
