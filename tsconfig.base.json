{
  "compilerOptions": {
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "rootDir": "${configDir}/src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "outDir": "${configDir}/dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@hanzo/cms-figma": ["../enterprise-plugins/packages/figma/src/index.ts"],
      "@payload-config": ["./test/_community/config.ts"],
      "@hanzo/cms-admin-bar": ["./packages/admin-bar/src"],
      "@hanzo/cms-live-preview": ["./packages/live-preview/src"],
      "@hanzo/cms-live-preview-react": ["./packages/live-preview-react/src/index.ts"],
      "@hanzo/cms-live-preview-vue": ["./packages/live-preview-vue/src/index.ts"],
      "@hanzo/cms-ui": ["./packages/ui/src/exports/client/index.ts"],
      "@hanzo/cms-ui/shared": ["./packages/ui/src/exports/shared/index.ts"],
      "@hanzo/cms-ui/rsc": ["./packages/ui/src/exports/rsc/index.ts"],
      "@hanzo/cms-ui/scss": ["./packages/ui/src/scss.scss"],
      "@hanzo/cms-ui/scss/app.scss": ["./packages/ui/src/scss/app.scss"],
      "@hanzo/cms-next/*": ["./packages/next/src/exports/*.ts"],
      "@hanzo/cms-richtext-lexical/client": [
        "./packages/richtext-lexical/src/exports/client/index.ts"
      ],
      "@hanzo/cms-richtext-lexical/rsc": ["./packages/richtext-lexical/src/exports/server/rsc.ts"],
      "@hanzo/cms-richtext-slate/rsc": ["./packages/richtext-slate/src/exports/server/rsc.ts"],
      "@hanzo/cms-plugin-ecommerce/ui": ["./packages/plugin-ecommerce/src/exports/ui.ts"],
      "@hanzo/cms-plugin-ecommerce/react": ["./packages/plugin-ecommerce/src/exports/react.ts"],
      "@hanzo/cms-plugin-ecommerce/types": ["./packages/plugin-ecommerce/src/exports/types.ts"],
      "@hanzo/cms-richtext-slate/client": [
        "./packages/richtext-slate/src/exports/client/index.ts"
      ],
      "@hanzo/cms-plugin-seo/client": ["./packages/plugin-seo/src/exports/client.ts"],
      "@hanzo/cms-plugin-sentry/client": ["./packages/plugin-sentry/src/exports/client.ts"],
      "@hanzo/cms-plugin-stripe/client": ["./packages/plugin-stripe/src/exports/client.ts"],
      "@hanzo/cms-plugin-search/client": ["./packages/plugin-search/src/exports/client.ts"],
      "@hanzo/cms-plugin-form-builder/client": [
        "./packages/plugin-form-builder/src/exports/client.ts"
      ],
      "@hanzo/cms-plugin-import-export/rsc": [
        "./packages/plugin-import-export/src/exports/rsc.ts"
      ],
      "@hanzo/cms-plugin-mcp": ["./packages/plugin-mcp/src/index.ts"],
      "@hanzo/cms-plugin-multi-tenant/rsc": ["./packages/plugin-multi-tenant/src/exports/rsc.ts"],
      "@hanzo/cms-plugin-multi-tenant/utilities": [
        "./packages/plugin-multi-tenant/src/exports/utilities.ts"
      ],
      "@hanzo/cms-plugin-multi-tenant/fields": [
        "./packages/plugin-multi-tenant/src/exports/fields.ts"
      ],
      "@hanzo/cms-plugin-multi-tenant/client": [
        "./packages/plugin-multi-tenant/src/exports/client.ts"
      ],
      "@hanzo/cms-plugin-multi-tenant": ["./packages/plugin-multi-tenant/src/index.ts"],
      "@hanzo/cms-plugin-multi-tenant/translations/languages/all": [
        "./packages/plugin-multi-tenant/src/translations/index.ts"
      ],
      "@hanzo/cms-plugin-multi-tenant/translations/languages/*": [
        "./packages/plugin-multi-tenant/src/translations/languages/*.ts"
      ],
      "@hanzo/cms-next": ["./packages/next/src/exports/*"],
      "@hanzo/cms-storage-azure/client": ["./packages/storage-azure/src/exports/client.ts"],
      "@hanzo/cms-storage-s3/client": ["./packages/storage-s3/src/exports/client.ts"],
      "@hanzo/cms-storage-vercel-blob/client": [
        "./packages/storage-vercel-blob/src/exports/client.ts"
      ],
      "@hanzo/cms-storage-gcs/client": ["./packages/storage-gcs/src/exports/client.ts"],
      "@hanzo/cms-storage-uploadthing/client": [
        "./packages/storage-uploadthing/src/exports/client.ts"
      ],
      "@hanzo/cms-storage-r2/client": ["./packages/storage-r2/src/exports/client.ts"]
    }
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/dist", "${configDir}/build", "${configDir}/temp", "**/*.spec.ts"]
}
